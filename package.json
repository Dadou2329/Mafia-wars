{
  "name": "mafia-wars-dadou-vs-even",
  "version": "1.0.0",
  "private": true,
  "description": "MAFIA WARS : Dadou vs Even — jeu multijoueur 3D voxel dans le Londres victorien",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n serveur,client -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --clear-screen=false src/server/main.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/server/main.js --packages=external",
    "start": "node dist/server/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "logo": "node scripts/build-logo.mjs",
    "test": "tsx tests/run-all.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "socket.io": "4.8.1",
    "socket.io-client": "4.8.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@fontsource/cinzel": "5.2.6",
    "@fontsource/cinzel-decorative": "5.2.6",
    "@fontsource/eb-garamond": "5.2.6",
    "@fontsource/unifrakturmaguntia": "5.2.6",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "22.15.3",
    "@types/three": "0.180.0",
    "concurrently": "9.1.2",
    "esbuild": "0.25.10",
    "opentype.js": "1.3.4",
    "playwright": "1.56.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
